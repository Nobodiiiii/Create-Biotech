        "src/main/resources/assets/create_biotech/ponder/generated/ponderer/allay_port_nether.nbt"
      ],
      "langEntries": {
        "zh_cn": {
          "create_biotech.ponder.allay_port_scene_1.header": "悦灵速递",
          "create_biotech.ponder.allay_port_scene_1.text_1": "悦灵驿站可以用来远程派送包裹",
          "create_biotech.ponder.allay_port_scene_1.text_2": "在界面中设置本站地址",
          "create_biotech.ponder.allay_port_scene_1.text_3": "李华",
          "create_biotech.ponder.allay_port_scene_1.text_4": "王芳",
          "create_biotech.ponder.allay_port_scene_1.text_5": "放入悦灵快递员",
          "create_biotech.ponder.allay_port_scene_1.text_6": "悦灵驿站会自动拉取下方打包机或容器中的包裹，并派出悦灵快递员送往指定悦灵驿站",
          "create_biotech.ponder.allay_port_scene_1.text_7": "→王芳",
          "create_biotech.ponder.allay_port_scene_1.text_8": "在界面中可以配置悦灵快递员是否返航",
          "create_biotech.ponder.allay_port_scene_1.text_9": "悦灵快递员运输没有距离限制，甚至可以跨越维度",
          "create_biotech.ponder.allay_port_scene_1.text_10": "但是需要确保涉及的站点位于被加载的区块中",
          "create_biotech.ponder.allay_port_s_21db7.header": "悦灵快递员与玩家",
          "create_biotech.ponder.allay_port_s_21db7.text_1": "悦灵快递员可以指定玩家为运输目标",
          "create_biotech.ponder.allay_port_s_21db7.text_2": "Nobodiiiii",
          "create_biotech.ponder.allay_port_s_21db7.text_3": "在地址栏中使用\"@玩家\"来匹配玩家",
          "create_biotech.ponder.allay_port_s_21db7.text_4": "→Nobodiiiii"
        },
        "en_us": {
          "create_biotech.ponder.allay_port_scene_1.header": "Allay Express Delivery",
          "create_biotech.ponder.allay_port_scene_1.text_1": "Cargo Allay Stations can be used to deliver packages remotely.",
          "create_biotech.ponder.allay_port_scene_1.text_2": "Set this station's address in its interface.",
          "create_biotech.ponder.allay_port_scene_1.text_3": "Peter",
          "create_biotech.ponder.allay_port_scene_1.text_4": "Albert",
          "create_biotech.ponder.allay_port_scene_1.text_5": "Insert an Allay Courier.",
          "create_biotech.ponder.allay_port_scene_1.text_6": "Cargo Allay Stations automatically pull packages from the Packager or container below and dispatch an Allay Courier to the specified Cargo Allay Station.",
          "create_biotech.ponder.allay_port_scene_1.text_7": "→ Albert",
          "create_biotech.ponder.allay_port_scene_1.text_8": "The interface lets you configure whether the Allay Courier returns after delivery.",
          "create_biotech.ponder.allay_port_scene_1.text_9": "Allay Couriers have no delivery range limit and can even travel between dimensions.",
          "create_biotech.ponder.allay_port_scene_1.text_10": "However, make sure all stations involved are in loaded chunks.",
          "create_biotech.ponder.allay_port_s_21db7.header": "Allay Couriers and Players",
          "create_biotech.ponder.allay_port_s_21db7.text_1": "Allay Couriers can target players for delivery.",
          "create_biotech.ponder.allay_port_s_21db7.text_2": "Nobodiiiii",
          "create_biotech.ponder.allay_port_s_21db7.text_3": "Use \"@player\" in the address field to target a player.",
          "create_biotech.ponder.allay_port_s_21db7.text_4": "→Nobodiiiii"
        }
      }
    }
  }
