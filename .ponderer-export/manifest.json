          "create_biotech.ponder.shulker_teleporter.header": "Scene 1",
          "create_biotech.ponder.shulker_teleporter.text_1": "潜影传送站可以在两个站点之间传送玩家、生物或掉落物",
          "create_biotech.ponder.shulker_teleporter.text_2": "在界面中设置本机地址和目标地址",
          "create_biotech.ponder.shulker_teleporter.text_3": "李华",
          "create_biotech.ponder.shulker_teleporter.text_4": "王芳",
          "create_biotech.ponder.shulker_teleporter.text_5": "→王芳",
          "create_biotech.ponder.shulker_teleporter.text_6": "Once sealed, entities inside are teleported to the target station."
        },
        "zh_cn": {
          "create_biotech.ponder.shulker_teleporter.header": "场景 1",
          "create_biotech.ponder.shulker_teleporter.text_1": "潜影传送站可以在两个站点之间传送玩家、生物或掉落物",
          "create_biotech.ponder.shulker_teleporter.text_2": "在界面中设置本机地址和目标地址",
          "create_biotech.ponder.shulker_teleporter.text_3": "李华",
          "create_biotech.ponder.shulker_teleporter.text_4": "王芳",
