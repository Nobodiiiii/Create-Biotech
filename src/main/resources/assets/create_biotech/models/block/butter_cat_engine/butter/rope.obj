# Rebuilt at a density of one texture pixel per half model pixel.
# The strap is one continuous rectangle with straight vertical sides.
# Its outside faces remain visible where the bread meets it; the bread omits those faces.
# The inner crosspiece keeps all four sides of the 4x4 Create shaft fully wrapped.
mtllib rope.mtl
o rope

# bottom of the rectangular strap
v 0.343750 0.343750 0.562500
v 0.656250 0.343750 0.562500
v 0.656250 0.375000 0.562500
v 0.343750 0.375000 0.562500
v 0.343750 0.343750 0.500000
v 0.656250 0.343750 0.500000
v 0.656250 0.375000 0.500000
v 0.343750 0.375000 0.500000

# full-height left side
v 0.343750 0.375000 0.562500
v 0.375000 0.375000 0.562500
v 0.375000 0.828125 0.562500
v 0.343750 0.828125 0.562500
v 0.343750 0.375000 0.500000
v 0.375000 0.375000 0.500000
v 0.375000 0.828125 0.500000
v 0.343750 0.828125 0.500000

# full-height right side
v 0.625000 0.375000 0.562500
v 0.656250 0.375000 0.562500
v 0.656250 0.828125 0.562500
v 0.625000 0.828125 0.562500
v 0.625000 0.375000 0.500000
v 0.656250 0.375000 0.500000
v 0.656250 0.828125 0.500000
v 0.625000 0.828125 0.500000

# crosspiece on top of the shaft; contact and end faces are intentionally omitted
v 0.375000 0.625000 0.562500
v 0.625000 0.625000 0.562500
v 0.625000 0.656250 0.562500
v 0.375000 0.656250 0.562500
v 0.375000 0.625000 0.500000
v 0.625000 0.625000 0.500000
v 0.625000 0.656250 0.500000
v 0.375000 0.656250 0.500000

# top of the rectangular strap; its lower face rests on the bread and is intentionally omitted
v 0.343750 0.828125 0.562500
v 0.656250 0.828125 0.562500
v 0.656250 0.859375 0.562500
v 0.343750 0.859375 0.562500
v 0.343750 0.828125 0.500000
v 0.656250 0.828125 0.500000
v 0.656250 0.859375 0.500000
v 0.343750 0.859375 0.500000

vn 0.000000 0.000000 1.000000
vn 0.000000 0.000000 -1.000000
vn 0.000000 -1.000000 0.000000
vn 1.000000 0.000000 0.000000
vn 0.000000 1.000000 0.000000
vn -1.000000 0.000000 0.000000

# The texture is 2x16. U spans of 0.5 represent 0.5 model pixels;
# V spans are physical run length divided by the texture's 8-model-pixel height.
vt 0.000000 0.000000
vt 0.500000 0.000000
vt 1.000000 0.000000
vt 0.000000 0.062500
vt 0.500000 0.062500
vt 1.000000 0.062500
vt 0.000000 0.625000
vt 0.500000 0.625000
vt 1.000000 0.625000
vt 0.000000 0.906250
vt 0.500000 0.906250
vt 1.000000 0.906250
vt 0.000000 0.500000
vt 0.500000 0.500000
vt 1.000000 0.500000

s 0
usemtl rope

# bottom: 5 px long = 10 texture pixels; top contact face is omitted
f 1/1/1 2/7/1 3/8/1 4/2/1
f 8/3/2 7/9/2 6/8/2 5/2/2
f 1/1/3 5/3/3 6/9/3 2/7/3
f 2/1/4 6/3/4 7/6/4 3/4/4
f 4/1/6 8/3/6 5/6/6 1/4/6

# left side: 7.25 px long = 14.5 texture pixels; joint caps are omitted
f 9/1/1 10/2/1 11/11/1 12/10/1
f 16/11/2 15/12/2 14/3/2 13/2/2
f 10/1/4 14/3/4 15/12/4 11/10/4
f 12/10/6 16/12/6 13/3/6 9/1/6

# right side: 7.25 px long = 14.5 texture pixels; joint caps are omitted
f 17/1/1 18/2/1 19/11/1 20/10/1
f 24/11/2 23/12/2 22/3/2 21/2/2
f 18/1/4 22/3/4 23/12/4 19/10/4
f 20/10/6 24/12/6 21/3/6 17/1/6

# shaft-top crosspiece: 4 px long = 8 texture pixels
f 25/1/1 26/13/1 27/14/1 28/2/1
f 32/3/2 31/15/2 30/14/2 29/2/2
f 27/1/5 31/3/5 32/15/5 28/13/5

# top: 5 px long = 10 texture pixels; lower bread-contact face is omitted
f 33/1/1 34/7/1 35/8/1 36/2/1
f 40/3/2 39/9/2 38/8/2 37/2/2
f 34/1/4 38/3/4 39/6/4 35/4/4
